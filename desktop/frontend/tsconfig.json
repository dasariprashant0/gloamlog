{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "preserveSymlinks": true
  },
  "include": ["src", "bindings"],
  "exclude": ["src/**/*.test.ts"]
}
